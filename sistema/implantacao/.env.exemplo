# Copiar para .env neste diretório (o .env fica fora do Git) e proteger: chmod 600 .env
#
# Conexão do papel sgj_app pelo pooler do Supabase em modo sessão (porta 5432).
# Copie a cadeia do painel do Supabase (botão Connect, opção Session pooler) e
# troque o usuário "postgres.<ref>" por "sgj_app.<ref>" e a senha pela do sgj_app.
SGJ_DB_DSN=postgresql://sgj_app.<ref-do-projeto>:<senha>@<endereco-do-pooler>:5432/postgres?sslmode=require
#
# Logins da rede privada Tailscale autorizados a usar o sistema, separados por vírgula.
SGJ_USUARIOS=<login-tailscale-do-titular>
